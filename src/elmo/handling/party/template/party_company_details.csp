<%c++
  using Row = std::map<std::string, std::string>;
  using Rows = std::vector<Row>;
  auto& o = party_company_details_tmp_stream;
  const auto& entity = @@.get<Row>("entity");
  const auto& record = @@.get<Row>("record");
  const auto& notice = @@.get<std::string>("notice");
  const auto& error = @@.get<std::string>("error");
  auto esc = [](const std::string& value) { return drogon::HttpViewData::htmlTranslate(value); };
  auto at = [](const Row& row, const std::string& key) { auto it = row.find(key); return it == row.end() ? std::string() : it->second; };
  const auto base = "/elmo/party/" + at(entity, "type");
  const auto module = at(entity, "module");
  auto nav = [&](const std::string& url, const std::string& target_module = "") {
    const auto m = target_module.empty() ? module : target_module;
    return "href=\"/elmo/home?t=" + m + "\" hx-get=\"" + esc(url) + "\" hx-target=\"#main-content\" hx-swap=\"innerHTML\" hx-push-url=\"?t=" + m + "\"";
  };
%>
<div class="space-y-6" data-party-page="details">
  <div class="breadcrumbs text-sm"><ul>
    <li><a <%c++ o << nav(base + "/list"); %>><%c++ o << esc(at(entity, "title")); %></a></li>
    <li><%c++ o << esc(at(record, "name")); %></li>
  </ul></div>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <h1 class="min-w-0 break-words text-2xl font-bold"><%c++ o << esc(at(record, "name")); %></h1>
    <div class="flex flex-wrap gap-2">
      <a class="btn btn-sm" <%c++ o << nav(base + "/" + at(record, "id") + "/edit"); %>>Editar</a>
      <button type="button" class="btn btn-sm btn-error" onclick="document.getElementById('party-delete-modal').showModal()">Eliminar</button>
    </div>
  </div>
<%c++ if (!notice.empty()) { %>
  <div role="alert" class="alert alert-success"><%c++ o << esc(notice); %></div>
<%c++ } %>
<%c++ if (!error.empty()) { %>
  <div role="alert" class="alert alert-error"><%c++ o << esc(error); %></div>
<%c++ } %>
  <dl class="grid gap-4 rounded-box border border-base-300 bg-base-100 p-4 sm:grid-cols-2">
<%c++ for (const auto& [key, label] : {std::pair{"ruc", "RUC"}, {"address", "Dirección"}, {"district", "Distrito"}}) { %>
    <div class="min-w-0"><dt class="text-sm text-base-content/60"><%c++ o << label; %></dt><dd class="break-words"><%c++ o << esc(at(record, key).empty() ? "—" : at(record, key)); %></dd></div>
<%c++ } %>
  </dl>
  <section class="space-y-4 rounded-box border border-base-300 bg-base-100 p-4">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 class="font-semibold">Contactos</h2>
      <a class="btn btn-sm" <%c++ o << nav("/elmo/party/contact/create?owner=" + at(entity, "type") + ":" + at(record, "id"), "partycontact"); %>>Nuevo contacto</a>
    </div>
<%c++ const auto& contacts = @@.get<Rows>("contacts"); if (contacts.empty()) { %>
    <p class="text-sm text-base-content/60">Aún no hay contactos para esta empresa.</p>
<%c++ } else { %>
    <div class="overflow-x-auto">
      <table class="table table-sm">
        <thead><tr><th>Nombre</th><th>Cargo</th><th>Teléfono</th><th>Correo</th></tr></thead>
        <tbody>
<%c++ for (const auto& contact : contacts) { %>
          <tr>
            <td><a class="link link-hover" <%c++ o << nav("/elmo/party/contact/" + at(contact, "id") + "/details", "partycontact"); %>><%c++ o << esc(at(contact, "name")); %></a></td>
            <td><%c++ o << esc(at(contact, "role")); %></td>
            <td><%c++ o << esc(at(contact, "phone")); %></td>
            <td><%c++ o << esc(at(contact, "email")); %></td>
          </tr>
<%c++ } %>
        </tbody>
      </table>
    </div>
<%c++ } %>
  </section>
  <dialog id="party-delete-modal" class="modal">
    <div class="modal-box">
      <h2 class="text-lg font-bold">¿Eliminar el <%c++ o << esc(at(entity, "singular")); %>?</h2>
      <p class="py-4 text-sm break-words">Se eliminará «<%c++ o << esc(at(record, "name")); %>». Solo se puede eliminar si no tiene registros vinculados.</p>
      <div class="modal-action">
        <form method="dialog"><button class="btn">Cancelar</button></form>
        <button type="button" class="btn btn-error" hx-post="<%c++ o << base << "/" << at(record, "id"); %>/delete" hx-target="#main-content" hx-swap="innerHTML" hx-push-url="?t=<%c++ o << module; %>" onclick="this.closest('dialog').close()">Eliminar</button>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button>Cerrar</button></form>
  </dialog>
</div>
